@model IEnumerable<CacaoTrigo.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<h1>Categorías</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear categoría</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var categoria in Model)
            {
                <tr>
                    <td>@categoria.Nombre</td>
                    <td class="text-end">
                        <a asp-action="Edit"
                           asp-route-id="@categoria.CategoriaId"
                           class="btn btn-outline-primary btn-sm">Editar</a>

                        <a asp-action="Details"
                           asp-route-id="@categoria.CategoriaId"
                           class="btn btn-outline-info btn-sm">Detalles</a>

                        <a asp-action="Delete"
                           asp-route-id="@categoria.CategoriaId"
                           class="btn btn-outline-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center text-muted">
                    Todavía no hay categorías registradas.
                </td>
            </tr>
        }
    </tbody>
</table>