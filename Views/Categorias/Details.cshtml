@model CacaoTrigo.Models.Categoria

@{
    ViewData["Title"] = "Detalles de categoría";
}

<h1>Detalles de categoría</h1>
<hr />

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Nombre)</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.CategoriaId"
       class="btn btn-primary">
        Editar
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Volver a la lista
    </a>
</div>