@model CacaoTrigo.Models.Promocion
@using System.Globalization

@{
    ViewData["Title"] = "Detalles de la promoción";
    var cultura = CultureInfo.GetCultureInfo("es-SV");
}

<h1>Detalles de la promoción</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">
        @(string.IsNullOrWhiteSpace(Model.Descripcion)
            ? "Sin descripción"
            : Model.Descripcion)
    </dd>

    <dt class="col-sm-3">Descuento</dt>
    <dd class="col-sm-9">
        @if (Model.EsPorcentaje)
        {
            @Model.ValorDescuento.ToString("N2", cultura)
            <text> %</text>
        }
        else
        {
            <text>$ </text>
            @Model.ValorDescuento.ToString("N2", cultura)
        }
    </dd>

    <dt class="col-sm-3">Fecha de inicio</dt>
    <dd class="col-sm-9">@Model.FechaInicio.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Fecha de fin</dt>
    <dd class="col-sm-9">@Model.FechaFin.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Condiciones</dt>
    <dd class="col-sm-9">
        @(string.IsNullOrWhiteSpace(Model.Condiciones)
            ? "Sin condiciones"
            : Model.Condiciones)
    </dd>

    <dt class="col-sm-3">Activa</dt>
    <dd class="col-sm-9">@(Model.Activa ? "Sí" : "No")</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.PromocionId"
       class="btn btn-primary">Editar</a>

    <a asp-action="Index"
       class="btn btn-secondary">Volver a la lista</a>
</div>