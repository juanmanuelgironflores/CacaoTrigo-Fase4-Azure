@model CacaoTrigo.Models.Promocion

@{
    ViewData["Title"] = "Editar promoción";
}

<h1>Editar promoción</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" asp-route-id="@Model.PromocionId" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="PromocionId" />

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ValorDescuento" class="form-label">Valor del descuento</label>
                <input asp-for="ValorDescuento" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="ValorDescuento" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="EsPorcentaje" class="form-check-input" />
                <label asp-for="EsPorcentaje" class="form-check-label">El descuento es un porcentaje</label>
            </div>

            <div class="mb-3">
                <label asp-for="FechaInicio" class="form-label">Fecha de inicio</label>
                <input asp-for="FechaInicio"
                       type="datetime-local"
                       asp-format="{0:yyyy-MM-ddTHH:mm}"
                       class="form-control" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaFin" class="form-label">Fecha de fin</label>
                <input asp-for="FechaFin"
                       type="datetime-local"
                       asp-format="{0:yyyy-MM-ddTHH:mm}"
                       class="form-control" />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Condiciones" class="form-label">Condiciones</label>
                <textarea asp-for="Condiciones" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Condiciones" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Activa" class="form-check-input" />
                <label asp-for="Activa" class="form-check-label">Promoción activa</label>
            </div>

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}