@model IEnumerable<CacaoTrigo.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";
}

<div class="container py-4">
    <h1>Pedidos</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">Crear pedido</a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Total</th>
                    <th>Nombre de contacto</th>
                    <th>Teléfono</th>
                    <th>Dirección de entrega</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var pedido in Model)
                    {
                        <tr>
                            <td class="text-nowrap">
                                @pedido.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>@pedido.Estado</td>
                            <td>@pedido.Total.ToString("0.00")</td>
                            <td>@pedido.NombreContacto</td>
                            <td>@pedido.TelefonoContacto</td>
                            <td>@pedido.DireccionEntrega</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit"
                                   asp-route-id="@pedido.PedidoId"
                                   class="btn btn-outline-primary btn-sm">Editar</a>

                                <a asp-action="Details"
                                   asp-route-id="@pedido.PedidoId"
                                   class="btn btn-outline-info btn-sm">Detalles</a>

                                <a asp-action="Delete"
                                   asp-route-id="@pedido.PedidoId"
                                   class="btn btn-outline-danger btn-sm">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            Todavía no hay pedidos registrados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>