@model CacaoTrigo.Models.Pedido

@{
    ViewData["Title"] = "Detalles del pedido";
}

<div class="container py-4">
    <h1>Detalles del pedido</h1>
    <h4>Pedido</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Fecha y hora</dt>
        <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">@Model.Estado</dd>

        <dt class="col-sm-3">Total</dt>
        <dd class="col-sm-9">$@Model.Total.ToString("0.00")</dd>

        <dt class="col-sm-3">Nombre de contacto</dt>
        <dd class="col-sm-9">@Model.NombreContacto</dd>

        <dt class="col-sm-3">Teléfono de contacto</dt>
        <dd class="col-sm-9">@Model.TelefonoContacto</dd>

        <dt class="col-sm-3">Dirección de entrega</dt>
        <dd class="col-sm-9">@Model.DireccionEntrega</dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Edit"
           asp-route-id="@Model.PedidoId"
           class="btn btn-outline-primary">Editar</a>

        <a asp-action="Index"
           class="btn btn-secondary">Volver a la lista</a>
    </div>
</div>