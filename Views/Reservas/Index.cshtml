@model IEnumerable<CacaoTrigo.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<div class="container py-4">
    <h1>Reservas</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">Crear reserva</a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Fecha y hora</th>
                    <th>Número de personas</th>
                    <th>Nombre de contacto</th>
                    <th>Teléfono</th>
                    <th>Correo electrónico</th>
                    <th>Zona</th>
                    <th>Estado</th>
                    <th>Mesa asignada</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var reserva in Model)
                    {
                        <tr>
                            <td class="text-nowrap">
                                @reserva.FechaHora.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>@reserva.NumeroPersonas</td>
                            <td>@reserva.NombreContacto</td>
                            <td>@reserva.TelefonoContacto</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(reserva.CorreoContacto))
                                {
                                    <a href="mailto:@reserva.CorreoContacto">
                                        @reserva.CorreoContacto
                                    </a>
                                }
                            </td>
                            <td>@(reserva.Zona ?? "Sin definir")</td>
                            <td>@reserva.Estado</td>
                            <td>
                                @if (reserva.Mesa != null)
                                {
                                    @($"Mesa {reserva.Mesa.Numero} - {reserva.Mesa.Ubicacion}")
                                }
                                else
                                {
                                    <span class="text-muted">Sin mesa asignada</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit"
                                   asp-route-id="@reserva.ReservaId"
                                   class="btn btn-outline-primary btn-sm">Editar</a>

                                <a asp-action="Details"
                                   asp-route-id="@reserva.ReservaId"
                                   class="btn btn-outline-info btn-sm">Detalles</a>

                                <a asp-action="Delete"
                                   asp-route-id="@reserva.ReservaId"
                                   class="btn btn-outline-danger btn-sm">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted">
                            Todavía no hay reservas registradas.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>