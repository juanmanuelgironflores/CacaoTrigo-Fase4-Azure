@model CacaoTrigo.Models.Mesa

@{
    ViewData["Title"] = "Editar mesa";
}

<div class="container py-4">
    <h1>Editar mesa</h1>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit"
                  asp-route-mesaid="@Model.MesaId"
                  method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="MesaId" />

                <div class="mb-3">
                    <label asp-for="Numero" class="form-label">Número de mesa</label>
                    <input asp-for="Numero" type="number" class="form-control" />
                    <span asp-validation-for="Numero" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Capacidad" class="form-label">Capacidad</label>
                    <input asp-for="Capacidad" type="number" class="form-control" />
                    <span asp-validation-for="Capacidad" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Ubicacion" class="form-label">Ubicación</label>
                    <input asp-for="Ubicacion" class="form-control" />
                    <span asp-validation-for="Ubicacion" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="Accesible" class="form-check-input" />
                    <label asp-for="Accesible" class="form-check-label">Accesible</label>
                </div>

                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}