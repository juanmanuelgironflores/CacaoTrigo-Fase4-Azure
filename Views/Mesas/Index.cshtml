@model IEnumerable<CacaoTrigo.Models.Mesa>

@{
    ViewData["Title"] = "Mesas";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Mesas</h1>
        <a asp-action="Create" class="btn btn-primary">Crear mesa</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Número de mesa</th>
                    <th>Capacidad</th>
                    <th>Ubicación</th>
                    <th>Accesible</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var mesa in Model)
                    {
                        <tr>
                            <td>@mesa.Numero</td>
                            <td>@mesa.Capacidad personas</td>
                            <td>@mesa.Ubicacion</td>
                            <td>@(mesa.Accesible ? "Sí" : "No")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit"
                                   asp-route-id="@mesa.MesaId"
                                   class="btn btn-outline-primary btn-sm">Editar</a>

                                <a asp-action="Details"
                                   asp-route-id="@mesa.MesaId"
                                   class="btn btn-outline-info btn-sm">Detalles</a>

                                <a asp-action="Delete"
                                   asp-route-id="@mesa.MesaId"
                                   class="btn btn-outline-danger btn-sm">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            Todavía no hay mesas registradas.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>