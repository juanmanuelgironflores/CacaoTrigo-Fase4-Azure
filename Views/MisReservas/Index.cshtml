@model IEnumerable<CacaoTrigo.Models.Reserva>

@{
    ViewData["Title"] = "Mis reservas";
}

<div class="ct-pagehead ct-pagehead--row">
    <div>
        <h1>Mis reservas</h1>
        <p>Tus mesas reservadas y las anteriores.</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary">Nueva reserva</a>
</div>

@if (!Model.Any())
{
    <div class="ct-emptybox">
        <p>Todavía no tienes reservas.</p>
        <a asp-action="Crear" class="btn btn-primary">Reservar una mesa</a>
    </div>
}
else
{
    <div class="ct-history">
        @foreach (var r in Model)
        {
            var puedeCancelar = r.Estado != "Cancelada" && r.FechaHora > DateTime.Now;

            <article class="ct-order">
                <header class="ct-order__head">
                    <div>
                        <strong>@r.FechaHora.ToString("dd/MM/yyyy") a las @r.FechaHora.ToString("HH:mm")</strong>
                        <span class="text-muted">@r.NumeroPersonas @(r.NumeroPersonas == 1 ? "persona" : "personas")</span>
                    </div>
                    <span class="ct-status ct-status--@r.Estado.ToLowerInvariant()">@r.Estado</span>
                </header>

                <ul class="ct-order__items">
                    <li><span>Zona</span><span>@(r.Zona ?? "Sin definir")</span></li>
                    <li>
                        <span>Mesa</span>
                        <span>
                            @if (r.Mesa != null)
                            {
                                @($"Mesa {r.Mesa.Numero}")
                            }
                            else
                            {
                                <span class="text-muted">Se asignará al confirmar</span>
                            }
                        </span>
                    </li>
                </ul>

                @if (puedeCancelar)
                {
                    <footer class="ct-order__foot">
                        <span></span>
                        <form asp-action="Cancelar" asp-route-id="@r.ReservaId" method="post"
                              onsubmit="return confirm('¿Cancelar esta reserva?');">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Cancelar reserva</button>
                        </form>
                    </footer>
                }
            </article>
        }
    </div>
}
