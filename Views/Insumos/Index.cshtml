@model IEnumerable<CacaoTrigo.Models.Insumo>

@{
    ViewData["Title"] = "Insumos";
}

<div class="container py-4">
    <h1>Insumos</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">Crear insumo</a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Unidad de medida</th>
                    <th>Cantidad disponible</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var insumo in Model)
                    {
                        <tr>
                            <td>@insumo.Nombre</td>
                            <td>@insumo.UnidadMedida</td>
                            <td>@insumo.CantidadDisponible.ToString("0.00")</td>
                            <td class="text-end">
                                <a asp-action="Edit"
                                   asp-route-id="@insumo.InsumoId"
                                   class="btn btn-outline-primary btn-sm">Editar</a>

                                <a asp-action="Details"
                                   asp-route-id="@insumo.InsumoId"
                                   class="btn btn-outline-info btn-sm">Detalles</a>

                                <a asp-action="Delete"
                                   asp-route-id="@insumo.InsumoId"
                                   class="btn btn-outline-danger btn-sm">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">
                            Todavía no hay insumos registrados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>