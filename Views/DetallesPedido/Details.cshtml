@model CacaoTrigo.Models.DetallePedido

@{
    ViewData["Title"] = "Detalles del producto del pedido";
}

<h1>Detalles del producto del pedido</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Pedido</dt>
    <dd class="col-sm-9">
        Pedido #@Model.PedidoId
        @if (Model.Pedido != null)
        {
            <span> - @Model.Pedido.NombreContacto</span>
        }
    </dd>

    <dt class="col-sm-3">Producto</dt>
    <dd class="col-sm-9">
        @if (Model.Producto != null)
        {
            @Model.Producto.Nombre
        }
        else
        {
            <span>Producto no disponible</span>
        }
    </dd>

    <dt class="col-sm-3">Cantidad</dt>
    <dd class="col-sm-9">@Model.Cantidad</dd>

    <dt class="col-sm-3">Precio unitario</dt>
    <dd class="col-sm-9">$@Model.PrecioUnitario.ToString("0.00")</dd>

    <dt class="col-sm-3">Subtotal</dt>
    <dd class="col-sm-9">$@Model.Subtotal.ToString("0.00")</dd>
</dl>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.DetallePedidoId"
       class="btn btn-primary">Editar</a>

    <a asp-action="Index"
       class="btn btn-secondary">Volver a la lista</a>
</div>