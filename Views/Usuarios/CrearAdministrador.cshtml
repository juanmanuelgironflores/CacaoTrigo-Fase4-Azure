@model CacaoTrigo.Models.ViewModels.CrearAdministradorViewModel

@{
    ViewData["FullWidth"] = true;
    ViewData["Title"] = "Nuevo administrador";
}

<section class="ct-authpage">
<div class="ct-auth ct-auth--compact">
    <div class="ct-auth__card">
        <h1>Nuevo administrador</h1>
        <p class="ct-auth__lead">La cuenta se creará con el rol de Administrador.</p>

        <form asp-action="CrearAdministrador" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label"></label>
                <input asp-for="NombreCompleto" class="form-control" autocomplete="off" />
                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" type="email" class="form-control" autocomplete="off" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contrasena" class="form-label"></label>
                <input asp-for="Contrasena" class="form-control" autocomplete="new-password" />
                <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula, número y un símbolo.</div>
                <span asp-validation-for="Contrasena" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmarContrasena" class="form-label"></label>
                <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">Crear administrador</button>
                <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
