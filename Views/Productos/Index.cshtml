@model IEnumerable<CacaoTrigo.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Productos</h1>
        <a asp-action="Create" class="btn btn-primary">Crear producto</a>
    </div>

    <form asp-action="Index" method="get" class="card card-body mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="buscar" class="form-label">Buscar</label>
                <input id="buscar"
                       name="buscar"
                       value="@ViewBag.BuscarActual"
                       class="form-control"
                       placeholder="Nombre o descripción" />
            </div>

            <div class="col-md-3">
                <label for="categoriaId" class="form-label">Categoría</label>
                <select id="categoriaId"
                        name="categoriaId"
                        asp-items="ViewBag.Categorias"
                        class="form-select">
                    <option value="">Todas las categorías</option>
                </select>
            </div>

            <div class="col-md-3">
                <label for="ordenar" class="form-label">Ordenar por</label>
                <select id="ordenar" name="ordenar" class="form-select">
                    <option value="" selected="@(ViewBag.OrdenActual == null || ViewBag.OrdenActual == "")">Nombre (A-Z)</option>
                    <option value="nombre_desc" selected="@(ViewBag.OrdenActual == "nombre_desc")">Nombre (Z-A)</option>
                    <option value="precio_asc" selected="@(ViewBag.OrdenActual == "precio_asc")">Precio (menor a mayor)</option>
                    <option value="precio_desc" selected="@(ViewBag.OrdenActual == "precio_desc")">Precio (mayor a menor)</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Aplicar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Precio</th>
                    <th>Disponible</th>
                    <th>Categoría</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var producto in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                                    {
                                        <img class="ct-thumb" src="@producto.ImagenUrl" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="ct-thumb ct-thumb--empty" aria-hidden="true"></span>
                                    }
                                    <span>@producto.Nombre</span>
                                </div>
                            </td>
                            <td>
                                @(string.IsNullOrWhiteSpace(producto.Descripcion)
                                    ? "Sin descripción"
                                    : producto.Descripcion)
                            </td>
                            <td>@producto.Precio.ToString("C2")</td>
                            <td>@(producto.Disponible ? "Sí" : "No")</td>
                            <td>@(producto.Categoria?.Nombre ?? "Sin categoría")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit"
                                   asp-route-id="@producto.ProductoId"
                                   class="btn btn-outline-primary btn-sm">Editar</a>

                                <a asp-action="Details"
                                   asp-route-id="@producto.ProductoId"
                                   class="btn btn-outline-info btn-sm">Detalles</a>

                                <a asp-action="Delete"
                                   asp-route-id="@producto.ProductoId"
                                   class="btn btn-outline-danger btn-sm">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">
                            No se encontraron productos.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>